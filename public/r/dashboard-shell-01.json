{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "dashboard-shell-01",
  "title": "Dashboard Shell 01",
  "description": "App layout: sticky sidebar navigation with user card, top bar with title and actions, and a native-dialog drawer on mobile.",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "app/components/blocks/dashboard-shell-01/DashboardShell01.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ShellCopy, ShellNavItem, ShellUser } from './types'\nimport { Menu, X } from '@lucide/vue'\nimport { computed, ref } from 'vue'\nimport { Button } from '@/components/ui/button'\nimport ShellNav from './ShellNav.vue'\n\nconst props = withDefaults(defineProps<{\n  items: ShellNavItem[]\n  activeId?: string\n  /** Page title in the top bar. */\n  title?: string\n  user?: ShellUser\n  copy?: Partial<ShellCopy>\n}>(), {\n  activeId: undefined,\n  title: undefined,\n  user: undefined,\n  copy: () => ({}),\n})\n\nconst emit = defineEmits<{\n  navigate: [itemId: string]\n}>()\n\nconst t = computed<ShellCopy>(() => ({\n  navLabel: 'Main',\n  openNavLabel: 'Open navigation',\n  closeNavLabel: 'Close navigation',\n  ...props.copy,\n}))\n\n// Mobile drawer: native <dialog> gives focus trapping, Escape and a backdrop.\nconst drawer = ref<HTMLDialogElement>()\n\nfunction openDrawer() {\n  drawer.value?.showModal()\n}\n\nfunction closeDrawer() {\n  drawer.value?.close()\n}\n\nfunction onDrawerClick(event: MouseEvent) {\n  // A click on the dialog box itself (not its content) is a click on the backdrop.\n  if (event.target === drawer.value)\n    closeDrawer()\n}\n\nfunction onNavigate(itemId: string) {\n  closeDrawer()\n  emit('navigate', itemId)\n}\n</script>\n\n<template>\n  <div class=\"min-h-dvh lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]\">\n    <aside class=\"sticky top-0 hidden h-dvh border-r bg-muted/30 lg:block\">\n      <ShellNav\n        :items=\"items\"\n        :active-id=\"activeId\"\n        :user=\"user\"\n        :nav-label=\"t.navLabel\"\n        @navigate=\"onNavigate\"\n      >\n        <template #brand>\n          <slot name=\"brand\" />\n        </template>\n      </ShellNav>\n    </aside>\n\n    <dialog\n      ref=\"drawer\"\n      :aria-label=\"t.navLabel\"\n      class=\"m-0 h-dvh max-h-none w-72 max-w-[85vw] border-r bg-background p-0 text-foreground backdrop:bg-black/50 lg:hidden\"\n      @click=\"onDrawerClick\"\n    >\n      <div class=\"relative h-full\">\n        <Button\n          variant=\"ghost\"\n          size=\"icon\"\n          class=\"absolute top-2.5 right-2\"\n          :aria-label=\"t.closeNavLabel\"\n          @click=\"closeDrawer\"\n        >\n          <X aria-hidden=\"true\" />\n        </Button>\n        <ShellNav\n          :items=\"items\"\n          :active-id=\"activeId\"\n          :user=\"user\"\n          :nav-label=\"t.navLabel\"\n          @navigate=\"onNavigate\"\n        >\n          <template #brand>\n            <slot name=\"brand\" />\n          </template>\n        </ShellNav>\n      </div>\n    </dialog>\n\n    <div class=\"flex min-w-0 flex-col\">\n      <header class=\"sticky top-0 z-10 flex h-14 shrink-0 items-center gap-3 border-b bg-background/95 px-4 backdrop-blur sm:px-6\">\n        <Button\n          variant=\"ghost\"\n          size=\"icon\"\n          class=\"-ml-2 lg:hidden\"\n          :aria-label=\"t.openNavLabel\"\n          @click=\"openDrawer\"\n        >\n          <Menu aria-hidden=\"true\" />\n        </Button>\n        <h1 v-if=\"title\" class=\"truncate text-base font-semibold\">\n          {{ title }}\n        </h1>\n        <div class=\"ml-auto flex items-center gap-2\">\n          <slot name=\"actions\" />\n        </div>\n      </header>\n\n      <main class=\"flex-1 p-4 sm:p-6\">\n        <slot />\n      </main>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/blocks/dashboard-shell-01/DashboardShell01.vue"
    },
    {
      "path": "app/components/blocks/dashboard-shell-01/ShellNav.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ShellNavItem, ShellUser } from './types'\nimport { computed } from 'vue'\n\nconst props = defineProps<{\n  items: ShellNavItem[]\n  activeId?: string\n  user?: ShellUser\n  navLabel: string\n}>()\n\nconst emit = defineEmits<{\n  navigate: [itemId: string]\n}>()\n\nconst initials = computed(() => (props.user?.name ?? '')\n  .split(/\\s+/)\n  .filter(Boolean)\n  .slice(0, 2)\n  .map(part => part[0]?.toUpperCase())\n  .join(''))\n</script>\n\n<template>\n  <div class=\"flex h-full flex-col\">\n    <div class=\"flex h-14 shrink-0 items-center border-b px-4\">\n      <slot name=\"brand\" />\n    </div>\n\n    <nav :aria-label=\"navLabel\" class=\"flex-1 overflow-y-auto p-3\">\n      <ul class=\"grid gap-1\">\n        <li v-for=\"item in items\" :key=\"item.id\">\n          <a\n            :href=\"item.href\"\n            :aria-current=\"item.id === activeId ? 'page' : undefined\"\n            class=\"flex items-center gap-3 rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-3 focus-visible:ring-ring/50 aria-[current=page]:bg-accent aria-[current=page]:font-medium aria-[current=page]:text-foreground\"\n            @click=\"emit('navigate', item.id)\"\n          >\n            <component :is=\"item.icon\" v-if=\"item.icon\" class=\"size-4 shrink-0\" aria-hidden=\"true\" />\n            <span class=\"flex-1 truncate\">{{ item.label }}</span>\n            <span\n              v-if=\"item.badge !== undefined\"\n              class=\"rounded-full bg-muted px-2 text-xs tabular-nums text-muted-foreground\"\n            >\n              {{ item.badge }}\n            </span>\n          </a>\n        </li>\n      </ul>\n    </nav>\n\n    <div v-if=\"user\" class=\"flex shrink-0 items-center gap-3 border-t p-4\">\n      <img\n        v-if=\"user.avatarUrl\"\n        :src=\"user.avatarUrl\"\n        alt=\"\"\n        class=\"size-8 shrink-0 rounded-full object-cover\"\n      >\n      <span\n        v-else\n        aria-hidden=\"true\"\n        class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium\"\n      >\n        {{ initials }}\n      </span>\n      <div class=\"min-w-0\">\n        <p class=\"truncate text-sm font-medium\">\n          {{ user.name }}\n        </p>\n        <p class=\"truncate text-xs text-muted-foreground\">\n          {{ user.email }}\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/blocks/dashboard-shell-01/ShellNav.vue"
    },
    {
      "path": "app/components/blocks/dashboard-shell-01/types.ts",
      "content": "import type { Component } from 'vue'\n\nexport interface ShellNavItem {\n  id: string\n  label: string\n  href: string\n  /** Any icon component, e.g. from @lucide/vue. */\n  icon?: Component\n  /** Small count or label after the item, e.g. unread items. */\n  badge?: string | number\n}\n\nexport interface ShellUser {\n  name: string\n  email: string\n  avatarUrl?: string\n}\n\nexport interface ShellCopy {\n  navLabel: string\n  openNavLabel: string\n  closeNavLabel: string\n}\n",
      "type": "registry:component",
      "target": "components/blocks/dashboard-shell-01/types.ts"
    },
    {
      "path": "app/components/blocks/dashboard-shell-01/index.ts",
      "content": "export { default as DashboardShell01 } from './DashboardShell01.vue'\nexport type { ShellCopy, ShellNavItem, ShellUser } from './types'\n",
      "type": "registry:component",
      "target": "components/blocks/dashboard-shell-01/index.ts"
    }
  ],
  "type": "registry:block"
}
