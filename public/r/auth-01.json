{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "auth-01",
  "title": "Auth 01",
  "description": "Sign-in and sign-up form in one component: typed submit payload, OAuth provider buttons, pending and error states.",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "app/components/blocks/auth-01/Auth01.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AuthCopy, AuthMode, AuthPayload, AuthProvider } from './types'\nimport { LoaderCircle } from '@lucide/vue'\nimport { computed, ref, useId } from 'vue'\nimport { Button } from '@/components/ui/button'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\n\nconst props = withDefaults(defineProps<{\n  mode?: AuthMode\n  providers?: AuthProvider[]\n  /** Link to the other mode (sign-up page from sign-in, and back). */\n  switchHref: string\n  forgotPasswordHref?: string\n  /** Form-level error, e.g. \"Incorrect email or password.\" */\n  error?: string\n  pending?: boolean\n  minPasswordLength?: number\n  copy?: Partial<AuthCopy>\n}>(), {\n  mode: 'sign-in',\n  providers: () => [],\n  forgotPasswordHref: undefined,\n  error: undefined,\n  pending: false,\n  minPasswordLength: 8,\n  copy: () => ({}),\n})\n\nconst emit = defineEmits<{\n  submit: [payload: AuthPayload]\n  provider: [providerId: string]\n}>()\n\nconst defaults: Record<AuthMode, AuthCopy> = {\n  'sign-in': {\n    title: 'Sign in',\n    description: 'Welcome back. Enter your details to continue.',\n    submitLabel: 'Sign in',\n    pendingLabel: 'Signing in',\n    nameLabel: 'Name',\n    emailLabel: 'Email',\n    passwordLabel: 'Password',\n    forgotPasswordLabel: 'Forgot password?',\n    dividerLabel: 'or with email',\n    switchPrompt: 'No account yet?',\n    switchLabel: 'Create one',\n  },\n  'sign-up': {\n    title: 'Create your account',\n    description: 'Start with a free account. You can invite your team later.',\n    submitLabel: 'Create account',\n    pendingLabel: 'Creating account',\n    nameLabel: 'Name',\n    emailLabel: 'Email',\n    passwordLabel: 'Password',\n    forgotPasswordLabel: 'Forgot password?',\n    dividerLabel: 'or with email',\n    switchPrompt: 'Already have an account?',\n    switchLabel: 'Sign in',\n  },\n}\n\nconst t = computed<AuthCopy>(() => ({ ...defaults[props.mode], ...props.copy }))\nconst isSignUp = computed(() => props.mode === 'sign-up')\n\nconst name = ref('')\nconst email = ref('')\nconst password = ref('')\n\nconst uid = useId()\nconst ids = {\n  name: `${uid}-name`,\n  email: `${uid}-email`,\n  password: `${uid}-password`,\n  passwordHint: `${uid}-password-hint`,\n  error: `${uid}-error`,\n}\n\nfunction onSubmit() {\n  if (props.pending)\n    return\n  const base = { email: email.value.trim(), password: password.value }\n  emit('submit', isSignUp.value\n    ? { mode: 'sign-up', name: name.value.trim(), ...base }\n    : { mode: 'sign-in', ...base })\n}\n</script>\n\n<template>\n  <section class=\"mx-auto w-full max-w-sm px-4 py-16 sm:py-24\">\n    <h1 class=\"text-2xl font-semibold tracking-tight\">\n      {{ t.title }}\n    </h1>\n    <p v-if=\"t.description\" class=\"mt-2 text-sm text-muted-foreground text-pretty\">\n      {{ t.description }}\n    </p>\n\n    <template v-if=\"providers.length\">\n      <div class=\"mt-8 grid gap-2\">\n        <Button\n          v-for=\"provider in providers\"\n          :key=\"provider.id\"\n          type=\"button\"\n          variant=\"outline\"\n          class=\"w-full\"\n          :disabled=\"pending\"\n          @click=\"emit('provider', provider.id)\"\n        >\n          <slot name=\"provider-icon\" :provider=\"provider\" />\n          {{ provider.label }}\n        </Button>\n      </div>\n\n      <div class=\"my-6 flex items-center gap-3 text-xs text-muted-foreground\">\n        <span class=\"h-px flex-1 bg-border\" />\n        {{ t.dividerLabel }}\n        <span class=\"h-px flex-1 bg-border\" />\n      </div>\n    </template>\n\n    <form\n      class=\"grid gap-4\"\n      :class=\"!providers.length && 'mt-8'\"\n      :aria-describedby=\"error ? ids.error : undefined\"\n      @submit.prevent=\"onSubmit\"\n    >\n      <div v-if=\"isSignUp\" class=\"grid gap-2\">\n        <Label :for=\"ids.name\">{{ t.nameLabel }}</Label>\n        <Input\n          :id=\"ids.name\"\n          v-model=\"name\"\n          name=\"name\"\n          autocomplete=\"name\"\n          required\n        />\n      </div>\n\n      <div class=\"grid gap-2\">\n        <Label :for=\"ids.email\">{{ t.emailLabel }}</Label>\n        <Input\n          :id=\"ids.email\"\n          v-model=\"email\"\n          type=\"email\"\n          name=\"email\"\n          autocomplete=\"email\"\n          inputmode=\"email\"\n          required\n          :aria-invalid=\"error ? true : undefined\"\n        />\n      </div>\n\n      <div class=\"grid gap-2\">\n        <div class=\"flex items-baseline justify-between gap-4\">\n          <Label :for=\"ids.password\">{{ t.passwordLabel }}</Label>\n          <a\n            v-if=\"!isSignUp && forgotPasswordHref\"\n            :href=\"forgotPasswordHref\"\n            class=\"text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline\"\n          >\n            {{ t.forgotPasswordLabel }}\n          </a>\n        </div>\n        <Input\n          :id=\"ids.password\"\n          v-model=\"password\"\n          type=\"password\"\n          name=\"password\"\n          :autocomplete=\"isSignUp ? 'new-password' : 'current-password'\"\n          :minlength=\"isSignUp ? minPasswordLength : undefined\"\n          required\n          :aria-invalid=\"error ? true : undefined\"\n          :aria-describedby=\"isSignUp ? ids.passwordHint : undefined\"\n        />\n        <p v-if=\"isSignUp\" :id=\"ids.passwordHint\" class=\"text-xs text-muted-foreground\">\n          <slot name=\"password-hint\" :min=\"minPasswordLength\">\n            At least {{ minPasswordLength }} characters.\n          </slot>\n        </p>\n      </div>\n\n      <p\n        v-if=\"error\"\n        :id=\"ids.error\"\n        role=\"alert\"\n        class=\"rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive\"\n      >\n        {{ error }}\n      </p>\n\n      <Button type=\"submit\" class=\"mt-2 w-full\" :disabled=\"pending\" :aria-busy=\"pending\">\n        <LoaderCircle v-if=\"pending\" class=\"animate-spin motion-reduce:animate-none\" aria-hidden=\"true\" />\n        {{ pending ? t.pendingLabel : t.submitLabel }}\n      </Button>\n    </form>\n\n    <p class=\"mt-8 text-sm text-muted-foreground\">\n      {{ t.switchPrompt }}\n      <a :href=\"switchHref\" class=\"font-medium text-foreground underline-offset-4 hover:underline\">\n        {{ t.switchLabel }}\n      </a>\n    </p>\n  </section>\n</template>\n",
      "type": "registry:component",
      "target": "components/blocks/auth-01/Auth01.vue"
    },
    {
      "path": "app/components/blocks/auth-01/types.ts",
      "content": "export type AuthMode = 'sign-in' | 'sign-up'\n\nexport interface SignInPayload {\n  mode: 'sign-in'\n  email: string\n  password: string\n}\n\nexport interface SignUpPayload {\n  mode: 'sign-up'\n  name: string\n  email: string\n  password: string\n}\n\nexport type AuthPayload = SignInPayload | SignUpPayload\n\nexport interface AuthProvider {\n  id: string\n  label: string\n}\n\nexport interface AuthCopy {\n  title: string\n  description: string\n  submitLabel: string\n  pendingLabel: string\n  nameLabel: string\n  emailLabel: string\n  passwordLabel: string\n  forgotPasswordLabel: string\n  dividerLabel: string\n  switchPrompt: string\n  switchLabel: string\n}\n",
      "type": "registry:component",
      "target": "components/blocks/auth-01/types.ts"
    },
    {
      "path": "app/components/blocks/auth-01/index.ts",
      "content": "export { default as Auth01 } from './Auth01.vue'\nexport type { AuthCopy, AuthMode, AuthPayload, AuthProvider, SignInPayload, SignUpPayload } from './types'\n",
      "type": "registry:component",
      "target": "components/blocks/auth-01/index.ts"
    }
  ],
  "type": "registry:block"
}
